# EarthCity runtime config
# This file WILL be loaded in both local and Heroku runtime (if committed).
# ⚠️ Keep this repo private. Anyone with access to the repo can see these secrets.

# --- Security (REQUIRED) ---
SECRET_KEY=change_me_to_long_random_secret
SECURITY_SALT=change_me_to_long_random_salt

# --- Cookies (recommended for HTTPS hosting like Heroku) ---
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax

# --- Database ---
# Heroku Postgres usually provides DATABASE_URL automatically.
# If you want to force it, set it here:
# DATABASE_URL=postgresql://...

# --- Admin bootstrap (recommended) ---
ADMIN_EMAIL=vovkot39@gmail.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_RESET_PASSWORD=0

# --- Email (optional; if empty, app returns dev_link instead of sending email) ---
MAIL_USERNAME=vovkot39@gmail.com
MAIL_PASSWORD=xxkn npgv sjcc luck
MAIL_DEFAULT_SENDER=EarthCity <vovkot39@gmail.com>

# Use this to force stable public URL in confirmation links (optional)
PUBLIC_BASE_URL=
